# Copy to `.env` next to docker-compose.yml and fill in real values.

# Postgres
DATABASE_USER=fundodaescola
DATABASE_PASSWORD=change_me_strong_password
DATABASE_NAME=fundodaescola_production

# Rails secrets — generate with: openssl rand -hex 64
SECRET_KEY_BASE=change_me
JWT_SECRET=change_me

# The GitHub Pages origin allowed to call the API (no trailing slash).
CORS_ORIGINS=https://fundodaescola.com.br

# Public API domain served by Caddy (TLS auto-provisioned)
API_DOMAIN=api.fundodaescola.com.br

# Frontend host used in email links
APP_HOST=fundodaescola.com.br

# Postmark (Server API token) — never commit the real value
POSTMARK_API_TOKEN=change_me
MAIL_FROM=Fundo da Escola <noreply@fundodaescola.com.br>
